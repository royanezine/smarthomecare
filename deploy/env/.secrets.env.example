# ============================================================
# SmartHomeCare - Kredensial rahasia (JANGAN di-commit ke git)
#
# Cara pakai:
#   cp deploy/env/.secrets.env.example deploy/env/.secrets.env
#   nano deploy/env/.secrets.env        # isi kredensial asli
#
# File deploy/env/.secrets.env sudah di-ignore oleh .gitignore,
# jadi aman dari push protection GitHub.
# ============================================================

# Google OAuth
GOOGLE_CLIENT_ID=GANTI_DENGAN_GOOGLE_CLIENT_ID
GOOGLE_CLIENT_SECRET=GANTI_DENGAN_GOOGLE_CLIENT_SECRET

# Midtrans
MIDTRANS_CLIENT_KEY=GANTI_DENGAN_MIDTRANS_CLIENT_KEY
MIDTRANS_MERCHANT_ID=GANTI_DENGAN_MIDTRANS_MERCHANT_ID
MIDTRANS_SERVER_KEY=GANTI_DENGAN_MIDTRANS_SERVER_KEY

# Email (Resend)
RESEND_API_KEY=GANTI_DENGAN_RESEND_API_KEY
MAIL_FROM_ADDRESS="faruqzhariif@faaruq.com"

# LocationIQ (maps)
LOCATIONIQ_KEY=GANTI_DENGAN_LOCATIONIQ_KEY