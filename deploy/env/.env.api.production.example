## Template .env Laravel produksi - smarthomecare.citrasolusi.id
## Copy ke /var/www/html/smarthomecare/api/.env (atau pakai backend/.env yang sudah diisi)

APP_NAME=SmartHomeCare
APP_ENV=local
APP_KEY=base64:GANTI_DENGAN_HASIL_KEY_GENERATE
APP_DEBUG=false
APP_URL=https://smarthomecare.citrasolusi.id

FRONTEND_URL=https://smarthomecare.citrasolusi.id

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=info

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=smartHomeCare
DB_USERNAME=smarthomecare
DB_PASSWORD=GANTI_DENGAN_PASSWORD_DB

QUEUE_CONNECTION=database
DB_QUEUE=wilayah
DB_QUEUE_RETRY_AFTER=7500
CACHE_STORE=database
FILESYSTEM_DISK=local

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_DOMAIN=.smarthomecare.citrasolusi.id
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

SANCTUM_STATEFUL_DOMAINS=localhost,localhost:3000,localhost:5173,127.0.0.1,127.0.0.1:3000,127.0.0.1:5173,smarthomecare.citrasolusi.id

CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173,https://smarthomecare.citrasolusi.id
CORS_ALLOWED_ORIGINS_PATTERNS=^https?://(localhost|127\.0\.0\.1)(:\d+)?$,^https?://([a-z0-9-]+\.)?smarthomecare\.citrasolusi\.id$

WEBSOCKET_URL=wss://smarthomecare.citrasolusi.id/ws
WEBSOCKET_HOST=127.0.0.1
WEBSOCKET_PORT=8088

LOCATIONIQ_KEY=GANTI_DENGAN_LOCATIONIQ_KEY

WILAYAH_PROVINCES_URL=https://www.emsifa.com/api-wilayah-indonesia/api/provinces.json
WILAYAH_REGENCIES_URL=https://www.emsifa.com/api-wilayah-indonesia/api/regencies/{id_provinsi}.json
WILAYAH_DISTRICTS_URL=https://www.emsifa.com/api-wilayah-indonesia/api/districts/{id_kota}.json
WILAYAH_VILLAGES_URL=https://www.emsifa.com/api-wilayah-indonesia/api/villages/{id_kecamatan}.json

MIDTRANS_MERCHANT_ID=GANTI_DENGAN_MERCHANT_ID
MIDTRANS_CLIENT_KEY=GANTI_DENGAN_CLIENT_KEY
MIDTRANS_SERVER_KEY=GANTI_DENGAN_SERVER_KEY
MIDTRANS_IS_PRODUCTION=false
MIDTRANS_IS_SANITIZED=true
MIDTRANS_IS_3DS=true
FEE_MIDTRANS=4000
MIDTRANS_EXPIRY_DURATION=15
MIDTRANS_EXPIRY_UNIT=minutes
MIDTRANS_CALLBACK_URL=https://smarthomecare.citrasolusi.id/api/midtrans/notification
MIDTRANS_NOTIFICATION_URL=https://smarthomecare.citrasolusi.id/api/midtrans/notification
MIDTRANS_FINISH_URL=https://smarthomecare.citrasolusi.id/payment/finish
MIDTRANS_UNFINISH_URL=https://smarthomecare.citrasolusi.id/payment/unfinish
MIDTRANS_ERROR_URL=https://smarthomecare.citrasolusi.id/payment/error
MIDTRANS_AUTO_SETTLEMENT=true

GOOGLE_CLIENT_ID=GANTI_DENGAN_GOOGLE_CLIENT_ID.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GANTI_DENGAN_GOOGLE_CLIENT_SECRET
GOOGLE_REDIRECT_URI=http://localhost:3000/auth/google/callback

MAIL_MAILER=resend
MAIL_FROM_ADDRESS="no-reply@smarthomecare.citrasolusi.id"
MAIL_FROM_NAME="${APP_NAME}"
RESEND_API_KEY=GANTI_DENGAN_RESEND_API_KEY

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=ap-southeast-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379