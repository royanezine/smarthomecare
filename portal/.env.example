# ============================================================
# Portal Next.js - Konfigurasi Environment
# Copy file ini menjadi .env.local untuk development
# atau .env.production untuk production build
# ============================================================

# URL dasar API Laravel (tanpa trailing slash)
NEXT_PUBLIC_API_URL=https://api.smarthomecare.id
NEXT_PUBLIC_API_BASE_URL=https://api.smarthomecare.id

# URL WebSocket Go service untuk chat & live tracking
# (wss diproxy via Apache dari api.smarthomecare.id/ws)
NEXT_PUBLIC_WS_URL=wss://api.smarthomecare.id/ws

# Google OAuth (browser)
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# Google OAuth (server-side, verifikasi token)
GOOGLE_CLIENT_ID=

# Waktu sesi cookie (detik)
# SESSION_MAX_AGE=604800