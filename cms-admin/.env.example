# ============================================================
# CMS Admin (React + Vite) - Konfigurasi Environment
# Copy file ini menjadi .env untuk development
# atau .env.production untuk production build
# ============================================================

# URL dasar API Laravel (tanpa trailing slash)
VITE_API_BASE_URL=https://api.smarthomecare.id

# URL WebSocket Go service (diproxy via Apache)
VITE_WS_URL=wss://api.smarthomecare.id/ws